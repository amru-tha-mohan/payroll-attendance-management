# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replace with your Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/payroll-attendance

# Fallback for local MongoDB if MONGO_URI is not set
# MONGO_URI=mongodb://127.0.0.1:27017/payroll-attendance

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
